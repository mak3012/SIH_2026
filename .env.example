# Template for .env. `make secrets` (python infra/env.py) creates .env from it and generates
# every empty secret below; reruns keep what is set. Never commit .env.
# Production and rig boxes: inject the secrets from the secret store instead (docs/security.md).

# --- Compose: files and profiles ---
# Laptop: the dev overlay (host ports on 127.0.0.1, internet for model pulls / downloads).
# Headquarters and rig boxes: delete COMPOSE_FILE (base file only, no egress).
COMPOSE_PATH_SEPARATOR=,
COMPOSE_FILE=docker-compose.yml,docker-compose.dev.yml
# hq: ingestion + observability. edge: Rig Edge Pack. dev: Ollama (laptop). See docker-compose.yml.
COMPOSE_PROFILES=hq,dev
# The demo replay runs as a one-off container; do not warn about it.
COMPOSE_IGNORE_ORPHANS=true

# --- Public endpoints (all HTTPS, through the `proxy` service) ---
# Host name browsers use. Add it (and any other names) to TLS_EXTRA_SANS for the certificates.
PUBLIC_HOST=localhost
TLS_EXTRA_SANS=
# Interface the proxy publishes on (127.0.0.1 keeps a laptop stack private).
BIND_ADDR=127.0.0.1
# The one address of the app: the web UI at /, the API at /api (docs at /api/docs), sign-in
# and sign-up (Keycloak) at /auth. Baked into the web build and the realm's redirect URIs.
WEB_PORT=5173
# HSTS max-age in seconds: 0 on a laptop (HSTS is per host and would force https on every
# localhost port); 31536000 on a real host name.
HSTS_MAX_AGE=0
# Grafana.
GRAFANA_PORT=3000

# --- PostgreSQL (TimescaleDB + PostGIS + pgvector, one cluster; ADR-0001) ---
# Superuser created on first start of an empty volume. Also used by Keycloak for its own DB.
POSTGRES_USER=app
# Generated. Changing it after first start requires `make down` + volume reset.
POSTGRES_PASSWORD=
# Application database; extensions are created here by infra/postgres/init.sql.
POSTGRES_DB=wells
# Encrypts the pgBackRest repository. Generated; keep a copy in the secret store: backups are
# unreadable without it.
BACKUP_CIPHER_PASS=

# --- Object store (S3-compatible, SeaweedFS: source PDFs and recordings) ---
S3_ROOT_USER=wells
# Generated (at least 8 characters).
S3_ROOT_PASSWORD=

# --- Keycloak (OIDC; realm "wells" imported from infra/keycloak/realm.json) ---
# Bootstrap admin for the master realm.
KEYCLOAK_ADMIN=admin
# Generated.
KEYCLOAK_ADMIN_PASSWORD=
# Secret of the `edge-sync` client (Rig Edge Pack uploads). Generated; the same value at HQ and
# on every rig box.
EDGE_SYNC_CLIENT_SECRET=

# --- Laptop-only host ports (docker-compose.dev.yml, bound to 127.0.0.1) ---
POSTGRES_PORT=15432
S3_PORT=9000
# Keycloak admin console: https://localhost:8444/auth/admin
KEYCLOAK_ADMIN_PORT=8444
DAGSTER_PORT=3001
PROMETHEUS_PORT=9090
OLLAMA_PORT=11434

# --- LLM / VLM (docs/pipelines.md, docs/assistant.md) ---
# The defaults suit a laptop without a GPU (the SIH demo). With a GPU, or at headquarters:
# LLM_MODEL=qwen2.5:7b-instruct, EMBED_BACKEND=ollama, LLM_MAX_TOKENS=2048, LLM_TIMEOUT_S=300,
# RT_EXPLAIN_TIMEOUT_S=30, ASSISTANT_DRAFTER=llm, then `make demo` (or `make up`) again; after
# changing EMBED_BACKEND rebuild the index (`make demo` does).
# "ollama", "vllm" (any OpenAI-compatible server, e.g. llama.cpp on a rig box) or "none". With
# "none" nothing is auto-accepted: every extracted value goes to the review queue.
LLM_BACKEND=ollama
# Laptop: the dev Ollama. Rig box: https://proxy:8081 (llama.cpp behind the proxy's TLS).
LLM_URL=http://ollama:11434
# Text model for extraction, lessons, briefings, explanations and chat (`make demo` pulls it).
LLM_MODEL=qwen2.5:1.5b-instruct
# Per-call output cap and timeout (a small model on a CPU can otherwise ramble to the timeout).
LLM_MAX_TOKENS=320
LLM_TIMEOUT_S=90
# How long the real-time service waits for an alert's explanation (the alert never waits).
RT_EXPLAIN_TIMEOUT_S=120
# WellMind answers drafted by "rules" (instant, verified) or "llm" (needs a GPU to be quick).
ASSISTANT_DRAFTER=rules
# Vision model for handwritten / hard pages.
VLM_MODEL=qwen2.5vl:7b
# faster-whisper model size for voice notes (tiny, base, small, medium, large-v3).
WHISPER_MODEL=small
# Assistant passage embeddings: "ollama" (EMBED_MODEL, 1024-d) or "hash" (offline, weaker).
EMBED_BACKEND=hash
EMBED_MODEL=bge-m3
# Values with confidence below this go to the review queue.
CONFIDENCE_THRESHOLD=0.8
# Second extraction pass: auto (LLM if configured), llm, ocr (PaddleOCR re-read) or none.
SECOND_PASS=auto

# --- Public data (make seed; laptop only, needs the dev overlay's internet access) ---
# Equinor Volve needs a personal licence acceptance; leave both empty to skip Volve.
VOLVE_SAS_URL=
VOLVE_DIR=

# --- Public wells (Sodir FactPages, open data NLOD 2.0; docs/data.md#public-wells) ---
# Daily Dagster schedule (05:00 UTC): upserts every Norwegian exploration wellbore for the map
# and fetches the completion reports of the newest few for extraction. Needs outbound HTTPS to
# factpages.sodir.no (laptop: the dev overlay). 0 where there is no route out.
SODIR_SYNC=1
# Wellbores whose completion reports (5-150 MB scans) are fetched per run; 0 = map data only.
SODIR_REPORTS_PER_RUN=3

# --- Observability (profile hq) ---
GRAFANA_ADMIN_USER=admin
# Generated.
GRAFANA_ADMIN_PASSWORD=
# Traces: Tempo's OTLP endpoint. Empty: no traces exported.
OTEL_EXPORTER_OTLP_ENDPOINT=https://tempo:4318

# --- Real time (make realtime; and the rig box) ---
# The simulator replays this seeded wellbore at RT_SIM_SPEED x (1-600). A feed silent for
# RT_STALE_AFTER_S seconds is shown as DATA STALE (grey).
RT_WELLBORE_ID=1
RT_SIM_SPEED=60
RT_STALE_AFTER_S=6
# WITSML store the real-time service polls: the simulator, or the rig's store on a rig box.
RT_WITSML_URL=https://witsml-sim:8090/witsml/store
# Detector bank (make rt-models). Roll back by pointing this at an archived bank:
# docs/operations/runbooks/model-rollback.md
RT_DETECTORS=data/models/realtime/detectors.joblib

# --- Rig Edge Pack (profile edge; docs/operations/edge.md) ---
# This box's name in headquarters' records, and its Keycloak client (edge-sync-<EDGE_ID> in
# production; the shared dev client `edge-sync` otherwise).
EDGE_ID=
EDGE_SYNC_CLIENT_ID=edge-sync
# Headquarters API and token endpoint, reached over VSAT.
HQ_URL=
HQ_TOKEN_URL=
# GGUF file in the models volume (models/llm/<file>), served by llama.cpp.
EDGE_LLM_MODEL_FILE=
