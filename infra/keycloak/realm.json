    },
    {
      "username": "service-account-edge-sync",
      "enabled": true,
      "serviceAccountClientId": "edge-sync",
      "realmRoles": [
        "edge_sync",
        "block:AA-ONN-2001/1",
        "block:AA-ONN-2001/2",
        "block:SA-BLK-1",
        "block:SA-BLK-2",
