{
  "realm": "wells",
  "enabled": true,
  "registrationAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read-only: every screen within the licence blocks, no actions. New self-registered users get it (and the demo blocks) until an admin assigns a working role"
      },
      {
        "name": "wellsite_engineer",
        "description": "Rig-side: live console, acknowledge and shelve alerts, alert feedback, voice notes"
      },
      {
        "name": "planner",
        "description": "Offset selection, drilling programs, program lint and briefings"
      },
      {
        "name": "superintendent",
        "description": "Fleet oversight; acknowledge and shelve alerts on any rig in their blocks"
      },
      {
        "name": "data_steward",
        "description": "Review queue: accept, correct or reject extracted values"
      },
      {
        "name": "admin",
        "description": "System status, detector bank, LLM configuration, audit verification; no data decisions"
      },
      {
        "name": "edge_sync",
        "description": "Rig Edge Pack service account: upload rig records, download hazard packages"
      },
      {
        "name": "block:AA-ONN-2001/1",
        "description": "May read licence block AA-ONN-2001/1 (ABAC)"
      },
      {
        "name": "block:AA-ONN-2001/2",
        "description": "May read licence block AA-ONN-2001/2 (ABAC)"
      },
      {
        "name": "block:SA-BLK-1",
        "description": "May read licence block SA-BLK-1 (ABAC)"
      },
      {
        "name": "block:SA-BLK-2",
        "description": "May read licence block SA-BLK-2 (ABAC)"
      },
      {
        "name": "block:SA-BLK-3",
        "description": "May read licence block SA-BLK-3 (ABAC)"
      },
      {
        "name": "block:NO-SODIR",
        "description": "May read licence block NO-SODIR (ABAC)"
      },
      {
        "name": "block:US-UT-FORGE",
        "description": "May read licence block US-UT-FORGE (ABAC)"
      },
      {
        "name": "block:NO-VOLVE-PL046",
        "description": "May read licence block NO-VOLVE-PL046 (ABAC)"
      },
      {
        "name": "jv:JV-DEMO",
        "description": "Partner in joint venture JV-DEMO (ABAC)"
      },
      {
        "name": "default-roles-wells",
        "description": "Given to every new user (sign-up): read-only access to the synthetic demo blocks and the public Sodir wells",
        "composite": true,
        "composites": {
          "realm": [
            "viewer",
            "block:SA-BLK-1",
            "block:SA-BLK-2",
            "block:SA-BLK-3",
            "block:AA-ONN-2001/1",
            "block:AA-ONN-2001/2",
            "block:NO-SODIR"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "web",
      "name": "Web UI",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://${PUBLIC_HOST}:${WEB_PORT}/*"
      ],
      "webOrigins": [
        "https://${PUBLIC_HOST}:${WEB_PORT}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://${PUBLIC_HOST}:${WEB_PORT}/*"
      },
      "protocolMappers": [
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "api",
      "name": "API (resource server)",
      "bearerOnly": true
    },
    {
      "clientId": "edge-sync",
      "name": "Rig Edge Pack sync (service account)",
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${EDGE_SYNC_CLIENT_SECRET}",
      "protocolMappers": [
        {
          "name": "api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "engineer",
